{
  "name": "pi-stats-ext",
  "version": "0.2.0",
  "description": "Dense local-first Pi coding-agent usage dashboard for tokens, costs, models, projects, and sessions.",
  "type": "module",
  "main": "./src/index.ts",
  "files": [
    "src",
    "README.md",
    "docs/img",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "stats",
    "usage",
    "tokens"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "prepublishOnly": "npm test && npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "@earendil-works/pi-tui": "latest",
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest"
  },
  "license": "MIT",
  "author": "Irfan Sofyana",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irfansofyana/pi-stats-ext.git"
  },
  "homepage": "https://github.com/irfansofyana/pi-stats-ext#readme",
  "bugs": {
    "url": "https://github.com/irfansofyana/pi-stats-ext/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
